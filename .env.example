# Copy to .env (which is gitignored) and fill in.
# TUNNEL_TOKEN is the per-tunnel JWT from Cloudflare Zero Trust → Tunnels →
# (your tunnel) → "Install and run a connector". It's NOT a Cloudflare API
# token; it can only run that one tunnel.
TUNNEL_TOKEN=

# Anthropic API key for AI written-response feedback (starts with sk-ant-).
ANTHROPIC_API_KEY=

# Optional: override the Claude model. Default is claude-haiku-4-5 (cheapest).
# Use claude-sonnet-4-6 or claude-opus-4-8 for more quality at higher cost.
# CLAUDE_MODEL=claude-haiku-4-5
